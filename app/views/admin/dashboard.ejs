<%- include('../layout/header', { pageTitle: 'Bảng Điều Khiển' }) %>

<div class="admin-container">
  <div class="admin-header">
    <div>
      <h2><i class="fa-solid fa-gauge-high"></i> TỔNG QUAN HỆ THỐNG</h2>
      <p style="color: var(--text-muted); font-size: 14px;">Trung tâm theo dõi chỉ số hoạt động phòng gym & hội viên thời gian thực</p>
    </div>
    <div class="admin-actions">
      <a href="/admin/members" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Hội Viên</a>
      <a href="/admin/schedules" class="btn btn-secondary"><i class="fa-solid fa-calendar-plus"></i> Lịch Tập</a>
      <a href="/admin/packages" class="btn btn-secondary"><i class="fa-solid fa-tags"></i> Gói Tập</a>
      <a href="/admin/trainers" class="btn btn-secondary"><i class="fa-solid fa-user-ninja"></i> Huấn Luyện Viên</a>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-icon" style="background: rgba(255, 107, 0, 0.15); color: var(--primary);">
        <i class="fa-solid fa-users"></i>
      </div>
      <div>
        <div class="kpi-num"><%= stats.totalMembers %></div>
        <div class="kpi-label">Tổng Số Hội Viên</div>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon" style="background: rgba(16, 185, 129, 0.15); color: var(--success);">
        <i class="fa-solid fa-user-check"></i>
      </div>
      <div>
        <div class="kpi-num"><%= stats.activeMembers %></div>
        <div class="kpi-label">Đang Hoạt Động</div>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);">
        <i class="fa-solid fa-clock"></i>
      </div>
      <div>
        <div class="kpi-num"><%= stats.pendingMembers %></div>
        <div class="kpi-label">Chờ Kích Hoạt / Tập Thử</div>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon" style="background: rgba(239, 68, 68, 0.15); color: var(--danger);">
        <i class="fa-solid fa-user-xmark"></i>
      </div>
      <div>
        <div class="kpi-num"><%= stats.expiredMembers %></div>
        <div class="kpi-label">Đã Hết Hạn Gói</div>
      </div>
    </div>
  </div>

  <div class="admin-tables-split">
    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-user-clock"></i> Hội Viên Đăng Ký Mới Nhất</h3>
        <a href="/admin/members" class="btn-link">Xem tất cả <i class="fa-solid fa-chevron-right"></i></a>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Họ Tên</th>
              <th>Số Điện Thoại</th>
              <th>Gói Tập</th>
              <th>Trạng Thái</th>
            </tr>
          </thead>
          <tbody>
            <% recentMembers.forEach(m => { %>
              <tr>
                <td style="font-weight: 600;"><%= m.full_name %></td>
                <td><%= m.phone %></td>
                <td><%= m.package_name || 'Tập thử 7 ngày' %></td>
                <td>
                  <span class="badge badge-<%= m.status %>">
                    <%= m.status === 'active' ? 'Hoạt động' : (m.status === 'pending' ? 'Chờ duyệt' : 'Hết hạn') %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-calendar-day"></i> Lịch Tập Hôm Nay</h3>
        <a href="/admin/schedules" class="btn-link">Xem tất cả <i class="fa-solid fa-chevron-right"></i></a>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Giờ Tập</th>
              <th>Hội Viên</th>
              <th>Huấn Luyện Viên</th>
              <th>Trạng Thái</th>
            </tr>
          </thead>
          <tbody>
            <% if (todaySchedules.length === 0) { %>
              <tr>
                <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 30px;">
                  Hôm nay chưa có lịch tập nào được ghi nhận.
                </td>
              </tr>
            <% } %>
            <% todaySchedules.forEach(s => { %>
              <tr>
                <td><strong><%= s.time_slot %></strong></td>
                <td><%= s.member_name %></td>
                <td><%= s.trainer_name || 'Tự tập cá nhân' %></td>
                <td>
                  <span class="badge badge-<%= s.status %>">
                    <%= s.status === 'scheduled' ? 'Sắp tới' : (s.status === 'completed' ? 'Hoàn thành' : 'Đã hủy') %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>
