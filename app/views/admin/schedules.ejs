<%- include('../layout/header', { pageTitle: 'Lịch Đặt Tập' }) %>

<div class="admin-container">

  <!-- Enterprise Admin Sub-Navigation Bar -->
  <div class="admin-nav-bar">
    <div class="admin-nav-pill-group">
      <a href="/admin" class="admin-nav-pill ">
        <i class="fa-solid fa-gauge-high"></i> <span>Tổng Quan</span>
      </a>
      <a href="/admin/members" class="admin-nav-pill ">
        <i class="fa-solid fa-users"></i> <span>Hội Viên</span>
      </a>
      <a href="/admin/packages" class="admin-nav-pill ">
        <i class="fa-solid fa-tags"></i> <span>Gói Tập</span>
      </a>
      <a href="/admin/trainers" class="admin-nav-pill ">
        <i class="fa-solid fa-user-ninja"></i> <span>Huấn Luyện Viên</span>
      </a>
      <a href="/admin/schedules" class="admin-nav-pill active">
        <i class="fa-solid fa-calendar-days"></i> <span>Lịch Tập</span>
      </a>
    </div>
    <div class="admin-nav-right">
      <a href="/" class="btn-return-site" title="Quay lại giao diện khách hàng">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> <span>Xem Trang Chủ</span>
      </a>
    </div>
  </div>

  <div class="admin-header-panel">
    <div class="admin-header-title">
      <h2><i class="fa-solid fa-calendar-days text-primary"></i> QUẢN LÝ LỊCH TẬP</h2>
      <p class="admin-header-subtitle">Phân bổ ca tập, gắn HLV phụ trách và cập nhật trạng thái hoàn thành buổi tập</p>
    </div>
    <div class="admin-header-actions">
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-schedule-card').scrollIntoView({ behavior: 'smooth' });">
        <i class="fa-solid fa-calendar-plus"></i> Đặt Lịch Tập Mới
      </button>
    </div>
  </div>

  <% if (msg === 'added') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Đặt lịch tập thành công!</div>
  <% } else if (msg === 'updated') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Cập nhật trạng thái lịch tập thành công!</div>
  <% } else if (msg === 'deleted') { %>
    <div class="alert alert-success"><i class="fa-solid fa-trash-can"></i> Đã xóa buổi tập thành công!</div>
  <% } else if (msg === 'error') { %>
    <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> Có lỗi xảy ra trong quá trình xử lý.</div>
  <% } %>

  <!-- Schedules Table -->
  <div class="glass-card mb-4">
    <div class="glass-card-header">
      <div class="card-title-group">
        <i class="fa-solid fa-clock-rotate-left text-primary"></i>
        <h3>Danh Sách Lịch Tập (<%= schedules.length %>)</h3>
      </div>
    </div>
    <div class="table-responsive">
      <table class="enterprise-table">
        <thead>
          <tr>
            <th>Mã</th>
            <th>Ngày Tập</th>
            <th>Khung Giờ</th>
            <th>Hội Viên</th>
            <th>Huấn Luyện Viên</th>
            <th>Môn Tập</th>
            <th>Trạng Thái</th>
            <th>Ghi Chú</th>
            <th>Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% if (schedules.length === 0) { %>
            <tr>
              <td colspan="9" class="empty-cell">
                <i class="fa-solid fa-calendar-xmark empty-icon"></i>
                <p>Chưa có buổi tập nào được xếp lịch.</p>
              </td>
            </tr>
          <% } %>
          <% schedules.forEach(s => { %>
            <tr>
              <td><span class="mono-text">#<%= s.id %></span></td>
              <td><span class="date-badge"><i class="fa-regular fa-calendar"></i> <%= new Date(s.session_date).toLocaleDateString('vi-VN') %></span></td>
              <td><span class="time-badge"><i class="fa-regular fa-clock"></i> <%= s.time_slot %></span></td>
              <td>
                <div class="user-fullname"><%= s.member_name %></div>
                <div class="user-email-sub"><%= s.member_phone %></div>
              </td>
              <td><strong><%= s.trainer_name || 'Tự tập cá nhân' %></strong></td>
              <td><span class="badge-pkg-name"><%= s.workout_type %></span></td>
              <td>
                <span class="status-pill status-<%= s.status %>">
                  <%= s.status === 'scheduled' ? 'Sắp tới' : (s.status === 'completed' ? 'Hoàn thành' : 'Đã hủy') %>
                </span>
              </td>
              <td><span class="note-truncate" title="<%= s.notes %>"><%= s.notes || '-' %></span></td>
              <td>
                <div class="action-buttons-group">
                  <% if (s.status === 'scheduled') { %>
                    <form action="/admin/schedules/status/<%= s.id %>" method="POST" style="display: inline;">
                      <input type="hidden" name="status" value="completed">
                      <button type="submit" class="btn-action btn-action-done" title="Xác nhận hoàn thành buổi tập">
                        <i class="fa-solid fa-check"></i>
                      </button>
                    </form>
                    <form action="/admin/schedules/status/<%= s.id %>" method="POST" style="display: inline;">
                      <input type="hidden" name="status" value="cancelled">
                      <button type="submit" class="btn-action btn-action-cancel" title="Hủy buổi tập">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </form>
                  <% } %>
                  <form action="/admin/schedules/delete/<%= s.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lịch tập này?');">
                    <button type="submit" class="btn-action btn-action-delete" title="Xóa lịch tập">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Schedule Form -->
  <div id="add-schedule-card" class="glass-card">
    <div class="glass-card-header">
      <div class="card-title-group">
        <i class="fa-solid fa-calendar-plus text-primary"></i>
        <h3>Xếp Lịch Tập Mới Cho Hội Viên</h3>
      </div>
    </div>
    <form action="/admin/schedules/add" method="POST" class="admin-form-styled">
      <div class="form-row-grid">
        <div class="form-group">
          <label class="form-label">Chọn Hội Viên (*)</label>
          <select name="member_id" class="form-control" required>
            <option value="">-- Chọn hội viên --</option>
            <% members.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.full_name %> (<%= m.phone %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Huấn Luyện Viên Hướng Dẫn</label>
          <select name="trainer_id" class="form-control">
            <option value="">-- Tự tập cá nhân (Không kèm PT) --</option>
            <% trainers.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.full_name %> (<%= t.specialty %>)</option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-group">
          <label class="form-label">Ngày Tập (*)</label>
          <input type="date" name="session_date" class="form-control" value="2026-10-18" required>
        </div>
        <div class="form-group">
          <label class="form-label">Khung Giờ (*)</label>
          <select name="time_slot" class="form-control" required>
            <option value="06:00 - 07:30">06:00 - 07:30 (Sáng sớm)</option>
            <option value="08:00 - 09:30">08:00 - 09:30 (Sáng)</option>
            <option value="10:00 - 11:30">10:00 - 11:30 (Trưa)</option>
            <option value="14:00 - 15:30">14:00 - 15:30 (Đầu giờ chiều)</option>
            <option value="16:00 - 17:30">16:00 - 17:30 (Chiều)</option>
            <option value="18:00 - 19:30" selected>18:00 - 19:30 (Tối cao điểm)</option>
            <option value="19:30 - 21:00">19:30 - 21:00 (Tối muộn)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Bài Tập / Bộ Môn</label>
          <select name="workout_type" class="form-control">
            <option value="Gym & Thể hình">Gym & Thể hình</option>
            <option value="Yoga trị liệu">Yoga trị liệu</option>
            <option value="Boxing & Kickfit">Boxing & Kickfit</option>
            <option value="Cardio đốt mỡ">Cardio đốt mỡ</option>
            <option value="Pilates định hình">Pilates định hình</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Ghi Chú Yêu Cầu Huấn Luyện</label>
        <input type="text" name="notes" class="form-control" placeholder="Ví dụ: Kiểm tra kỹ thuật tạ đòn, khởi động kỹ cơ vai...">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-md btn-glow">
          <i class="fa-solid fa-floppy-disk"></i> Xác Nhận Xếp Lịch
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
