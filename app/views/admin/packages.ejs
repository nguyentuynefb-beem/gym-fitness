<%- include('../layout/header', { pageTitle: 'Quản Lý Gói Tập' }) %>

<div class="admin-container">
  <div class="admin-header">
    <div>
      <h2><i class="fa-solid fa-tags"></i> QUẢN LÝ GÓI TẬP</h2>
      <p style="color: var(--text-muted); font-size: 14px;">Tùy chỉnh danh mục, học phí và các quyền lợi ưu đãi cho từng gói tập</p>
    </div>
    <div class="admin-actions">
      <a href="/admin" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại Dashboard</a>
      <button class="btn btn-primary" onclick="document.getElementById('add-package-card').scrollIntoView({ behavior: 'smooth' });">
        <i class="fa-solid fa-plus"></i> Thêm Gói Tập
      </button>
    </div>
  </div>

  <% if (msg === 'added') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Thêm mới gói tập thành công!</div>
  <% } else if (msg === 'updated') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Cập nhật gói tập thành công!</div>
  <% } else if (msg === 'deleted') { %>
    <div class="alert alert-success"><i class="fa-solid fa-trash-can"></i> Đã xóa gói tập thành công!</div>
  <% } else if (msg === 'error') { %>
    <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> Có lỗi xảy ra trong quá trình xử lý.</div>
  <% } %>

  <div class="card" style="margin-bottom: 30px;">
    <div class="card-header">
      <h3><i class="fa-solid fa-list-check"></i> Danh Sách Gói Tập Hiện Có (<%= packages.length %>)</h3>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Mã</th>
            <th>Tên Gói</th>
            <th>Danh Mục</th>
            <th>Thời Hạn</th>
            <th>Giá Tiền (VND)</th>
            <th>Mô Tả & Tiện Ích</th>
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
          </tr>
        </thead>
        <tbody>
          <% packages.forEach(pkg => { %>
            <tr>
              <td>#<%= pkg.id %></td>
              <td style="font-weight: 700; color: var(--text-primary);"><%= pkg.name %></td>
              <td><span class="pkg-badge"><%= pkg.category %></span></td>
              <td><%= pkg.duration_months %> tháng</td>
              <td style="font-weight: 700; color: var(--primary);">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(pkg.price) %>
              </td>
              <td>
                <div style="font-size: 13px; color: var(--text-muted);"><%= pkg.description %></div>
                <div style="font-size: 12px; color: var(--success);"><%= pkg.features %></div>
              </td>
              <td>
                <span class="badge badge-<%= pkg.is_active ? 'active' : 'expired' %>">
                  <%= pkg.is_active ? 'Đang mở bán' : 'Tạm ngưng' %>
                </span>
              </td>
              <td>
                <form action="/admin/packages/delete/<%= pkg.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa gói tập này?');">
                  <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 12px;">
                    <i class="fa-solid fa-trash"></i> Xóa
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div id="add-package-card" class="card">
    <div class="card-header">
      <h3><i class="fa-solid fa-plus-circle"></i> Thêm Gói Tập Mới</h3>
    </div>
    <form action="/admin/packages/add" method="POST" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label>Tên Gói Tập (*)</label>
          <input type="text" name="name" class="form-control" placeholder="Ví dụ: Gói Platinum 6 Tháng" required>
        </div>
        <div class="form-group">
          <label>Danh Mục (*)</label>
          <select name="category" class="form-control">
            <option value="Gym">Gym Cơ Bản</option>
            <option value="Yoga">Yoga Chuyên Sâu</option>
            <option value="Boxing">Boxing & Kickfit</option>
            <option value="VIP">VIP Toàn Năng</option>
          </select>
        </div>
        <div class="form-group">
          <label>Thời Hạn (Tháng) (*)</label>
          <input type="number" name="duration_months" class="form-control" value="1" min="1" max="60" required>
        </div>
        <div class="form-group">
          <label>Học Phí (VNĐ) (*)</label>
          <input type="number" name="price" class="form-control" placeholder="Ví dụ: 800000" min="0" step="10000" required>
        </div>
      </div>

      <div class="form-group">
        <label>Mô Tả Ngắn</label>
        <input type="text" name="description" class="form-control" placeholder="Tự do tập luyện không giới hạn khung giờ...">
      </div>

      <div class="form-group">
        <label>Tiện Ích Đi Kèm (ngăn cách bởi dấu phẩy)</label>
        <input type="text" name="features" class="form-control" placeholder="Tủ đồ riêng, Nước uống ion, Xông hơi Sauna, Đo InBody định kỳ">
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top: 10px;">
        <i class="fa-solid fa-floppy-disk"></i> Lưu Gói Tập Mới
      </button>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
