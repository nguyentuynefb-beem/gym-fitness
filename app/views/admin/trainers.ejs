<%- include('../layout/header', { pageTitle: 'Quản Lý Huấn Luyện Viên' }) %>

<div class="admin-container">

  <!-- Enterprise Admin Sub-Navigation Bar -->
  <div class="admin-nav-bar">
    <div class="admin-nav-pill-group">
      <a href="/admin" class="admin-nav-pill ">
        <i class="fa-solid fa-gauge-high"></i> <span>Tổng Quan</span>
      </a>
      <a href="/admin/members" class="admin-nav-pill ">
        <i class="fa-solid fa-users"></i> <span>Hội Viên</span>
      </a>
      <a href="/admin/packages" class="admin-nav-pill ">
        <i class="fa-solid fa-tags"></i> <span>Gói Tập</span>
      </a>
      <a href="/admin/trainers" class="admin-nav-pill active">
        <i class="fa-solid fa-user-ninja"></i> <span>Huấn Luyện Viên</span>
      </a>
      <a href="/admin/schedules" class="admin-nav-pill ">
        <i class="fa-solid fa-calendar-days"></i> <span>Lịch Tập</span>
      </a>
    </div>
    <div class="admin-nav-right">
      <a href="/" class="btn-return-site" title="Quay lại giao diện khách hàng">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> <span>Xem Trang Chủ</span>
      </a>
    </div>
  </div>

  <div class="admin-header-panel">
    <div class="admin-header-title">
      <h2><i class="fa-solid fa-user-ninja text-primary"></i> QUẢN LÝ HUẤN LUYỆN VIÊN (PT)</h2>
      <p class="admin-header-subtitle">Quản lý đội ngũ HLV thể hình, chuyên môn, chứng chỉ quốc tế và tình trạng công tác</p>
    </div>
    <div class="admin-actions">
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-trainer-card').scrollIntoView({ behavior: 'smooth' });">
        <i class="fa-solid fa-user-plus"></i> Thêm HLV Mới
      </button>
    </div>
  </div>

  <% if (msg === 'added') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Thêm mới Huấn luyện viên thành công!</div>
  <% } else if (msg === 'updated') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Cập nhật HLV thành công!</div>
  <% } else if (msg === 'deleted') { %>
    <div class="alert alert-success"><i class="fa-solid fa-trash-can"></i> Đã xóa thông tin HLV thành công!</div>
  <% } else if (msg === 'error') { %>
    <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> Có lỗi xảy ra trong quá trình xử lý.</div>
  <% } %>

  <!-- Trainers Table -->
  <div class="glass-card mb-4">
    <div class="glass-card-header">
      <div class="card-title-group">
        <i class="fa-solid fa-id-badge text-primary"></i>
        <h3>Đội Ngũ Huấn Luyện Viên Hiện Tại (<%= trainers.length %>)</h3>
      </div>
    </div>
    <div class="table-responsive">
      <table class="enterprise-table">
        <thead>
          <tr>
            <th>Mã</th>
            <th>Huấn Luyện Viên</th>
            <th>Số Điện Thoại</th>
            <th>Chuyên Môn</th>
            <th>Kinh Nghiệm</th>
            <th>Tiểu Sử / Bằng Cấp</th>
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
          </tr>
        </thead>
        <tbody>
          <% trainers.forEach(t => { %>
            <tr>
              <td><span class="mono-text">#<%= t.id %></span></td>
              <td>
                <div class="member-identity">
                  <img src="<%= t.avatar_url %>" alt="<%= t.full_name %>" class="user-avatar-pt" onerror="this.src='/images/trainers/trainer-1.jpg'">
                  <div>
                    <div class="user-fullname"><%= t.full_name %></div>
                    <div class="user-email-sub"><%= t.email || 'pt@titanfitness.vn' %></div>
                  </div>
                </div>
              </td>
              <td><span class="mono-text"><%= t.phone %></span></td>
              <td><span class="pkg-cat-badge"><%= t.specialty %></span></td>
              <td><span class="time-badge"><i class="fa-solid fa-medal"></i> <%= t.experience_years %> Năm</span></td>
              <td><span class="note-truncate" title="<%= t.bio %>"><%= t.bio %></span></td>
              <td>
                <span class="status-pill status-<%= t.status === 'active' ? 'active' : 'expired' %>">
                  <%= t.status === 'active' ? 'Đang làm việc' : 'Tạm nghỉ' %>
                </span>
              </td>
              <td>
                <form action="/admin/trainers/delete/<%= t.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa HLV này?');">
                  <button type="submit" class="btn-action btn-action-delete" title="Xóa HLV">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Trainer Form -->
  <div id="add-trainer-card" class="glass-card">
    <div class="glass-card-header">
      <div class="card-title-group">
        <i class="fa-solid fa-user-plus text-primary"></i>
        <h3>Đăng Ký Hồ Sơ Huấn Luyện Viên Mới</h3>
      </div>
    </div>
    <form action="/admin/trainers/add" method="POST" class="admin-form-styled">
      <div class="form-row-grid">
        <div class="form-group">
          <label class="form-label">Họ và Tên (*)</label>
          <input type="text" name="full_name" class="form-control" placeholder="Ví dụ: Hoàng Tuấn Kiệt" required>
        </div>
        <div class="form-group">
          <label class="form-label">Số Điện Thoại (*)</label>
          <input type="tel" name="phone" class="form-control" placeholder="0909888777" required>
        </div>
        <div class="form-group">
          <label class="form-label">Email Liên Hệ</label>
          <input type="email" name="email" class="form-control" placeholder="pt@titanfitness.vn">
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-group">
          <label class="form-label">Chuyên Môn Chính (*)</label>
          <input type="text" name="specialty" class="form-control" placeholder="Ví dụ: Thể hình & Siết cơ, Yoga Flow, Kickfit..." required>
        </div>
        <div class="form-group">
          <label class="form-label">Số Năm Kinh Nghiệm (*)</label>
          <input type="number" name="experience_years" class="form-control" value="1" min="0" max="40" required>
        </div>
        <div class="form-group">
          <label class="form-label">Trạng Thái Công Tác</label>
          <select name="status" class="form-control">
            <option value="active">Đang làm việc (Active)</option>
            <option value="inactive">Tạm nghỉ (Inactive)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Tiểu Sử, Chứng Chỉ Quốc Tế & Thành Tựu</label>
        <textarea name="bio" class="form-control" rows="2" placeholder="Ví dụ: Chứng chỉ NASM CPT Hoa Kỳ, Cựu VĐV Thể hình quốc gia, chuyên gia phục hồi chuyển hóa..."></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-md btn-glow">
          <i class="fa-solid fa-floppy-disk"></i> Lưu Hồ Sơ Huấn Luyện Viên
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
