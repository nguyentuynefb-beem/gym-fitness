<%- include('../layout/header', { pageTitle: 'Quản Lý Huấn Luyện Viên' }) %>

<div class="admin-container">
  <div class="admin-header">
    <div>
      <h2><i class="fa-solid fa-user-ninja"></i> QUẢN LÝ HUẤN LUYỆN VIÊN (PT)</h2>
      <p style="color: var(--text-muted); font-size: 14px;">Quản lý danh sách HLV, chuyên môn, kinh nghiệm giảng dạy và tình trạng công tác</p>
    </div>
    <div class="admin-actions">
      <a href="/admin" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại Dashboard</a>
      <button class="btn btn-primary" onclick="document.getElementById('add-trainer-card').scrollIntoView({ behavior: 'smooth' });">
        <i class="fa-solid fa-user-plus"></i> Thêm HLV Mới
      </button>
    </div>
  </div>

  <% if (msg === 'added') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Thêm mới Huấn luyện viên thành công!</div>
  <% } else if (msg === 'updated') { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> Cập nhật HLV thành công!</div>
  <% } else if (msg === 'deleted') { %>
    <div class="alert alert-success"><i class="fa-solid fa-trash-can"></i> Đã xóa thông tin HLV thành công!</div>
  <% } else if (msg === 'error') { %>
    <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> Có lỗi xảy ra trong quá trình xử lý.</div>
  <% } %>

  <div class="card" style="margin-bottom: 30px;">
    <div class="card-header">
      <h3><i class="fa-solid fa-id-badge"></i> Đội Ngũ Huấn Luyện Viên (<%= trainers.length %>)</h3>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Mã</th>
            <th>Họ và Tên</th>
            <th>Số Điện Thoại</th>
            <th>Chuyên Môn</th>
            <th>Kinh Nghiệm</th>
            <th>Tiểu Sử / Giới Thiệu</th>
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
          </tr>
        </thead>
        <tbody>
          <% trainers.forEach(t => { %>
            <tr>
              <td>#<%= t.id %></td>
              <td style="font-weight: 700; color: var(--text-primary);"><%= t.full_name %></td>
              <td><%= t.phone %></td>
              <td><span class="pkg-badge"><%= t.specialty %></span></td>
              <td><%= t.experience_years %> năm</td>
              <td style="font-size: 13px; color: var(--text-muted);"><%= t.bio %></td>
              <td>
                <span class="badge badge-<%= t.status === 'active' ? 'active' : 'expired' %>">
                  <%= t.status === 'active' ? 'Đang làm việc' : 'Tạm nghỉ' %>
                </span>
              </td>
              <td>
                <form action="/admin/trainers/delete/<%= t.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa HLV này?');">
                  <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 12px;">
                    <i class="fa-solid fa-trash"></i> Xóa
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div id="add-trainer-card" class="card">
    <div class="card-header">
      <h3><i class="fa-solid fa-user-plus"></i> Đăng Ký Huấn Luyện Viên Mới</h3>
    </div>
    <form action="/admin/trainers/add" method="POST" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label>Họ và Tên (*)</label>
          <input type="text" name="full_name" class="form-control" placeholder="Ví dụ: Hoàng Tuấn Kiệt" required>
        </div>
        <div class="form-group">
          <label>Số Điện Thoại (*)</label>
          <input type="tel" name="phone" class="form-control" placeholder="0909888777" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" placeholder="pt@titanfitness.vn">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Chuyên Môn (*)</label>
          <input type="text" name="specialty" class="form-control" placeholder="Ví dụ: Thể hình & Siết cơ, Yoga, Kickfit..." required>
        </div>
        <div class="form-group">
          <label>Số Năm Kinh Nghiệm (*)</label>
          <input type="number" name="experience_years" class="form-control" value="1" min="0" max="40" required>
        </div>
        <div class="form-group">
          <label>Trạng Thái</label>
          <select name="status" class="form-control">
            <option value="active">Đang làm việc (Active)</option>
            <option value="inactive">Tạm nghỉ (Inactive)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Tiểu Sử & Bằng Cấp Chứng Chỉ</label>
        <textarea name="bio" class="form-control" rows="2" placeholder="Chứng chỉ NASM CPT, cựu vận động viên thể hình..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top: 10px;">
        <i class="fa-solid fa-floppy-disk"></i> Lưu Hồ Sơ Huấn Luyện Viên
      </button>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>
