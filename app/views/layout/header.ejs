<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>TITAN FITNESS - Trung Tâm Thể Hình & Wellness Đẳng Cấp</title>
  
  <!-- Preconnect & Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6.5.1 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Custom Core Design System -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Announce Bar (Optional subtle announcement) -->
  <div class="top-bar">
    <div class="top-bar-inner">
      <div class="top-bar-left">
        <span><i class="fa-solid fa-clock"></i> Mở cửa: 05:30 - 22:00 hàng ngày</span>
        <span class="sep">•</span>
        <span><i class="fa-solid fa-phone"></i> Hotline: 1900 6868</span>
      </div>
      <div class="top-bar-right">
        <span class="badge-promo"><i class="fa-solid fa-bolt"></i> Ưu đãi tháng 10: Tặng 7 ngày tập thử miễn phí</span>
      </div>
    </div>
  </div>

  <!-- Primary Navigation -->
  <header class="site-header" id="siteHeader">
    <div class="nav-wrapper">
      <a href="/" class="brand-logo" aria-label="Titan Fitness Trang Chủ">
        <div class="brand-symbol">
          <i class="fa-solid fa-dumbbell"></i>
        </div>
        <div class="brand-text">
          <span class="brand-name">TITAN</span>
          <span class="brand-sub">FITNESS</span>
        </div>
      </a>

      <!-- Desktop Menu -->
      <nav class="nav-desktop" id="navDesktop">
        <ul class="nav-links">
          <li><a href="/#about" class="nav-item"><i class="fa-solid fa-circle-info"></i> Giới Thiệu</a></li>
          <li><a href="/#facilities" class="nav-item"><i class="fa-solid fa-dumbbell"></i> Tiện Ích 5 Sao</a></li>
          <li><a href="/#packages" class="nav-item"><i class="fa-solid fa-tags"></i> Gói Tập</a></li>
          <li><a href="/#trainers" class="nav-item"><i class="fa-solid fa-user-ninja"></i> Huấn Luyện Viên</a></li>
          <li><a href="/#schedules" class="nav-item"><i class="fa-solid fa-calendar-days"></i> Lịch Lớp Tuần</a></li>
        </ul>
      </nav>

      <!-- Nav Actions -->
      <div class="nav-actions">
        <a href="/#trial-form" class="btn btn-primary btn-sm btn-glow">
          <i class="fa-solid fa-bolt"></i> Tập Thử 7 Ngày
        </a>
        <a href="/admin" class="btn-staff-portal" title="Cổng quản trị hệ thống">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Cổng Quản Trị</span>
        </a>
        <button class="mobile-toggle" id="mobileToggle" aria-label="Mở menu điều hướng">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <ul class="mobile-nav-links">
        <li><a href="/#about"><i class="fa-solid fa-circle-info"></i> Giới Thiệu</a></li>
        <li><a href="/#facilities"><i class="fa-solid fa-dumbbell"></i> Tiện Ích 5 Sao</a></li>
        <li><a href="/#packages"><i class="fa-solid fa-tags"></i> Gói Tập</a></li>
        <li><a href="/#trainers"><i class="fa-solid fa-user-ninja"></i> Huấn Luyện Viên</a></li>
        <li><a href="/#schedules"><i class="fa-solid fa-calendar-days"></i> Lịch Lớp Tuần</a></li>
        <li><a href="/#trial-form" class="text-primary"><i class="fa-solid fa-bolt"></i> Đăng Ký Tập Thử</a></li>
        <li><a href="/admin" class="text-staff"><i class="fa-solid fa-shield-halved"></i> Cổng Quản Trị Hệ Thống</a></li>
      </ul>
    </div>
  </header>
