      "targets": [
        {
          "expr": "rate(mysql_global_status_bytes_received[1m])",
          "legendFormat": "Bytes Received"
        },
        {
          "expr": "rate(mysql_global_status_bytes_sent[1m])",
          "legendFormat": "Bytes Sent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "Bps"
        }
      }
    },
    {
